DirectoryIndex index.php index.html
Options -Indexes

<FilesMatch "(?:^\.|\.(?i:sql|md|log|sh|py|ps1|cjs|docx)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\. - [F,L]
</IfModule>
